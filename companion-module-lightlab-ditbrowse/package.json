{
  "name": "companion-module-lightlab-ditbrowse",
  "version": "1.0.0",
  "description": "Bitfocus Companion module for local DIT Browse control",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "format": "prettier -w .",
    "package": "npm run build && companion-module-build",
    "check": "npm run companion-module-check",
    "companion-module-check": "node scripts/check-module.mjs",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint:raw": "eslint",
    "lint": "npm run lint:raw -- .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightlab/companion-module-lightlab-ditbrowse.git"
  },
  "engines": {
    "node": "^22.20",
    "yarn": "^4"
  },
  "dependencies": {
    "@companion-module/base": "2.0.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@companion-module/tools": "3.0.1",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3.2.4"
  },
  "prettier": "@companion-module/tools/.prettierrc.json",
  "packageManager": "yarn@4.17.0",
  "dependenciesMeta": {
    "@companion-module/base@2.0.4": {
      "unplugged": true
    },
    "@companion-module/tools@3.0.2": {
      "unplugged": true
    }
  }
}
